Source: "wbstartup.s"
                            	     1: ;****************************************************************
                            	     2: ; Workbench startup handshake.
                            	     3: ;
                            	     4: ; A program launched by double-clicking its icon is started by
                            	     5: ; Workbench, which sends a WBStartupMessage to the new process and
                            	     6: ; then waits for that message to be replied. A program that never
                            	     7: ; picks up and replies the message locks Workbench and may be
                            	     8: ; unloaded while still executing.
                            	     9: ;
                            	    10: ; Usage (must wrap the whole program):
                            	    11: ;   jsr WBStartup        ; before TakeSystem
                            	    12: ;   jsr TakeSystem
                            	    13: ;   jsr main
                            	    14: ;   jsr ReleaseSystem
                            	    15: ;   jmp WBExit           ; last thing before returning to DOS
                            	    16: ;
                            	    17: ; (c) 2026 by Piotr Rozentreter (Rozsoft)
                            	    18: ;****************************************************************
