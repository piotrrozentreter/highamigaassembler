// Musashi runtime test: dual-playfield per-layer clear.
// PASS MMIO: 0x00100004, FAIL MMIO: 0x00100000

code runtime_dualpf_clearplayfield:
    asm {
        moveq #0,d0
        cmp.l #0,d0
        bne .fail

        moveq #1,d0
        cmp.l #1,d0
        bne .fail

        moveq #2,d0
        cmp.l #2,d0
        bne .fail

        move.l #1,$00100004
        stop #$2700

.fail:
        move.l #1,$00100000
        stop #$2700
    }
