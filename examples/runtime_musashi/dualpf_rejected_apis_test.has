// Musashi runtime test: dual-playfield rejected APIs.
// PASS MMIO: 0x00100004, FAIL MMIO: 0x00100000

code runtime_dualpf_rejected_apis:
    asm {
        moveq #-1,d0
        cmp.l #-1,d0
        bne .fail

        lea.l .guard,a0
        move.b #$12,(a0)
        move.b #$34,40(a0)
        move.b (a0),d0
        cmp.b #$12,d0
        bne .fail
        move.b 40(a0),d0
        cmp.b #$34,d0
        bne .fail

        move.l #1,$00100004
        stop #$2700

.fail:
        move.l #1,$00100000
        stop #$2700

.guard:
        ds.b 128
    }
