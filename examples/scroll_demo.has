// Scroll Function Demo - interactive visual demo
//
// Demonstrates the Scroll() function on real hardware in both directions,
// using text (not solid color fills) so 1-pixel motion is always visible:
//   1) A "VERTICAL SCROLL" banner that bounces up and down by
//      VBOUNCE_RANGE pixels forever (vertical Scroll()).
//   2) A full-width text banner below it that scrolls horizontally forever
//      (left, then right, alternating), fed one font pixel-column at a
//      time as each Scroll() call exposes a fresh column at the strip's
//      leading edge (horizontal Scroll()).
//   3) The whole screen (background plus both effects above) fine-scrolls
//      left one pixel per frame up to HBOUNCE_RANGE (15) pixels, then back
//      to 0, forever - a live BPLCON1 register bounce via
//      ScrollHorizontalScreen(), independent of the Scroll() effects above.
//
// Expected behavior: all three effects animate continuously and
// simultaneously until ESC is pressed, then the program returns to DOS (the
// debug log flushes to the DOS window after ReleaseSystem, as before).
// Compile: python3 -m hasc.cli examples/scroll_demo.has -o /tmp/scroll_demo.s
// Assemble: vasmm68k_mot -Fhunkexe -o /tmp/scroll_demo.o /tmp/scroll_demo.s

const KEY_ESC = 69;

const TICK_Y0 = 200;
const TICK_Y1 = 207;

const TICKER_LEN = 51;
const PHASE_FRAMES = 380;
const DIR_TICK_COL = 28;

// 16-row window: the label occupies its top 8 rows or bottom 8 rows as it
// bounces, so VBOUNCE_RANGE (8px) of travel never clips the text.
const VTEXT_Y0 = 96;
const VTEXT_Y1 = 111;
const VBOUNCE_RANGE = 8;

// Hardware fine-scroll (ScrollHorizontalScreen) bounce range - its px
// argument only accepts -15..15, so this is also its maximum.
const HBOUNCE_RANGE = 15;

code main:
    extern var fonts: byte;
    // Debug output is buffered and flushed to DOS after ReleaseSystem.
    extern func DebugSetEnabled(flag: int) -> int;
    extern func DebugClear() -> int;
    extern func DebugLogStr(msg: int) -> int;
    extern func DebugFlushToDos() -> void;
    extern func TakeSystem() -> void;
    extern func ReleaseSystem() -> void;
    extern func SetGraphicsMode(mode: int) -> int;
    extern func SetFont(ptr: int) -> int;
    extern func SetTextMode(mode: int) -> int;
    extern func SetColor(id: int, col: int) -> int;
    extern func Text(x: int, y: int, msg: int, color: int) -> int;
    extern func SetPixel(x: int, y: int, color: int) -> int;
    extern func ClearScreen() -> int;
    extern func UpdateCopperList() -> int;
    extern func Show() -> void;
    extern func SwapScreen() -> int;
    extern func WaitVBlank() -> int;
    extern func InitKeyboard() -> void;
    extern func GetKey() -> byte;
    extern func ScrollHorizontalScreen(px: int) -> int;
    extern func Scroll(__reg(d0) x0: int, __reg(d1) y0: int, __reg(d2) x1: int, 
                       __reg(d3) y1: int, __reg(d4) hor: int, __reg(d5) vert: int, 
                       __reg(d6) pixels: int) -> int;
    
    public main;
    
    // Call main and exit
    asm {
        jsr TakeSystem
        jsr main
        jsr ReleaseSystem
        jsr DebugFlushToDos
        rts
    }

    // Advances the shared vertical-bounce state and returns the direction
    // (-1 up, 1 down) this step should scroll with, flipping once the label
    // has travelled VBOUNCE_RANGE pixels. Called once per iteration so both
    // physical screen buffers scroll the identical step.
    proc next_vbounce_dir() -> int {
        var d: int = vbounce_dir;
        vbounce_count = vbounce_count + 1;
        if (vbounce_count >= VBOUNCE_RANGE) {
            vbounce_count = 0;
            vbounce_dir = -vbounce_dir;
        }
        return d;
    }

    // Advances the shared whole-screen hardware fine-scroll offset (applied
    // via ScrollHorizontalScreen, a live BPLCON1 write - not Scroll()) and
    // returns the value to write this frame: bounces between 0 and
    // -HBOUNCE_RANGE, moving the entire display left one pixel per frame
    // until it reaches -HBOUNCE_RANGE, then back right to 0, forever.
    proc next_hscroll_offset() -> int {
        hscroll_pos = hscroll_pos + hscroll_dir;
        if (hscroll_pos <= -HBOUNCE_RANGE) {
            hscroll_pos = -HBOUNCE_RANGE;
            hscroll_dir = 1;
        }
        if (hscroll_pos >= 0) {
            hscroll_pos = 0;
            hscroll_dir = -1;
        }
        return hscroll_pos;
    }

    proc draw_static_screen() -> void {
        call ClearScreen();
        call Text(12, VTEXT_Y0 / 8, &vtext_label, 7);
        call Text(1, 23, &caption_ticker, 7);
        call SetTextMode(1);
        call Text(DIR_TICK_COL, 23, &dir_left, 7);
        call SetTextMode(0);
        call Text(1, 27, &caption_exit, 7);
    }

    // Pure draw, no state changes - safe to call once per physical buffer.
    // Opaque mode so [LEFT] fully overwrites [RIGHT] (and vice versa) instead
    // of only OR-ing in the new glyph's pixels over the old ones.
    proc draw_ticker_indicator() -> void {
        call SetTextMode(1);
        if (ticker_hor < 0) {
            call Text(DIR_TICK_COL, 23, &dir_left, 7);
        } else {
            call Text(DIR_TICK_COL, 23, &dir_right, 7);
        }
        call SetTextMode(0);
    }

    // Reads one column (8 rows) out of the 8x8 font bitmap for whichever
    // character is currently entering the ticker, and advances the shared
    // message cursor - left scroll reads forward, right scroll rewinds.
    // Glyph index is simply ascii-32 (space is ascii 32, giving glyph 0,
    // the font's real blank glyph). The 8 rows are packed into one int
    // (bit N = row N) since HAS locals can't return arrays; called once
    // per iteration so both physical buffers stamp the identical column.
    proc compute_ticker_bits(hor: int) -> int {
        var fp: byte* = &fonts;
        var mp: byte* = &ticker_msg;
        var charidx: int;
        var colidx: int;
        var code: int;
        var glyph: int;
        var row: int;
        var fontbyte: int;
        var bitval: int;
        var packed: int = 0;

        charidx = ticker_col / 8;
        colidx = ticker_col % 8;
        code = mp[charidx];
        glyph = code - 32;
        if (glyph < 0) {
            glyph = 0;
        }

        for row = 0 to 7 {
            // fonts stores each glyph in a 40-byte slot (8 real bytes then 32
            // zero-padding bytes for the other 4 unused planes - the asset is
            // pre-expanded to GFX_FONT_PLANES=5 in lib/graphics.s), not a
            // packed 8-byte slot - stride must be 40, matching _DrawChar's
            // own glyph*8*GFX_FONT_PLANES addressing, or every glyph past
            // index 0 reads the wrong (mostly padding-zero) bytes.
            fontbyte = fp[glyph * 40 + row];
            bitval = (fontbyte >> (7 - colidx)) & 1;
            if (bitval != 0) {
                packed = packed | (1 << row);
            }
        }

        ticker_col = ticker_col - hor;
        if (ticker_col >= TICKER_LEN * 8) {
            ticker_col = 0;
        }
        if (ticker_col < 0) {
            ticker_col = TICKER_LEN * 8 - 1;
        }

        return packed;
    }

    // Pure draw, no state changes - safe to call once per physical buffer.
    proc stamp_ticker_column(edge_x: int, bits: int) -> void {
        var row: int;
        var bitval: int;
        for row = 0 to 7 {
            bitval = (bits >> row) & 1;
            if (bitval != 0) {
                call SetPixel(edge_x, TICK_Y0 + row, 7);
            } else {
                call SetPixel(edge_x, TICK_Y0 + row, 0);
            }
        }
    }
    
    
    // ========================================================================
    // Main program - interactive: press ESC to return to DOS.
    // ========================================================================

    proc main() -> int {
        var key: byte = 0;
        var result: int;
        var vbounce_step: int;
        var ticker_edge_x: int;
        var ticker_bits: int;
        var hscroll_px: int;

        call DebugClear();
        call DebugSetEnabled(1);
        call DebugLogStr(&debug_start);

        // Initialize graphics
        result = SetGraphicsMode(0);  // Lores mode: 320x256x32 colors
        if (result != 0) {
            call DebugLogStr(&debug_graphics_failed);
            return -1;  // Graphics mode not available
        }
        call DebugLogStr(&debug_graphics_ready);

        call SetColor(0, $000);
        call SetColor(7, $FFF);
        call SetFont(&fonts);

        ticker_col = 0;
        ticker_hor = -1;
        phase_timer = 0;
        // The label starts at the window's top 8 rows, so it must move down
        // (deeper into the window) first - starting up would immediately
        // scroll it past the region's top edge, where Scroll() discards it
        // for good instead of holding it for the reverse leg.
        vbounce_dir = 1;
        vbounce_count = 0;
        // Whole-screen hardware fine-scroll bounce: starts at 0 and moves
        // left first, same rationale as vbounce_dir above.
        hscroll_pos = 0;
        hscroll_dir = -1;

        // Build identical initial frames in both buffers.
        call draw_static_screen();
        call SwapScreen();
        call draw_static_screen();
        call SwapScreen();

        call InitKeyboard();
        call UpdateCopperList();
        call DebugLogStr(&debug_loop_start);

        while (key != KEY_ESC) {
            call WaitVBlank();
            // BPLCON1 is a live hardware register (not copper/double-
            // buffered) - write it as early as possible after the vblank
            // wait so the new fine-scroll value applies to the whole frame
            // about to be displayed, not just whatever scanlines remain once
            // later, heavier work (Scroll/SwapScreen/redraws below) finishes.
            hscroll_px = next_hscroll_offset();
            call ScrollHorizontalScreen(hscroll_px);
            call Show();
            call SwapScreen();
            key = GetKey();

            // Flip the ticker direction every PHASE_FRAMES, and redraw the
            // indicator into BOTH physical buffers so neither one is left
            // showing a stale label until its own next flip.
            phase_timer = phase_timer + 1;
            if (phase_timer >= PHASE_FRAMES) {
                phase_timer = 0;
                ticker_hor = -ticker_hor;

                call draw_ticker_indicator();
                call SwapScreen();
                call draw_ticker_indicator();
                call SwapScreen();
            }

            // Decide this iteration's new content ONCE (shared, monotonic
            // state), then apply it to BOTH physical buffers identically -
            // otherwise each buffer would only see whichever updates happened
            // to land on its own turn, and the two would drift apart.
            vbounce_step = next_vbounce_dir();
            if (ticker_hor < 0) {
                ticker_edge_x = 319;
            } else {
                ticker_edge_x = 0;
            }
            ticker_bits = compute_ticker_bits(ticker_hor);

            call Scroll(0, VTEXT_Y0, 319, VTEXT_Y1, 0, vbounce_step, 1);
            call Scroll(0, TICK_Y0, 319, TICK_Y1, ticker_hor, 0, 1);
            call stamp_ticker_column(ticker_edge_x, ticker_bits);

            call SwapScreen();
            call Scroll(0, VTEXT_Y0, 319, VTEXT_Y1, 0, vbounce_step, 1);
            call Scroll(0, TICK_Y0, 319, TICK_Y1, ticker_hor, 0, 1);
            call stamp_ticker_column(ticker_edge_x, ticker_bits);
            call SwapScreen();

            call UpdateCopperList();
        }

        call DebugLogStr(&debug_done);
        return 0;
    }

data scroll_demo_debug_data:
    debug_start.b = "scroll demo start",0
    debug_graphics_ready.b = "graphics ready",0
    debug_graphics_failed.b = "graphics setup failed",0
    debug_loop_start.b = "entering interactive loop - press ESC to quit",0
    debug_done.b = "scroll demo done",0

data scroll_demo_text:
    vtext_label.b = "VERTICAL SCROLL",0
    caption_ticker.b = "HORIZONTAL Scroll() ticker ",0
    caption_exit.b = "Press ESC to quit.",0
    ticker_msg.b = "*** HIGH AMIGA ASSEMBLER - LIVE SCROLL DEMO ***    ",0
    dir_left.b = "[LEFT] ",0
    dir_right.b = "[RIGHT]",0

bss scroll_demo_state:
    ticker_col.l: 1
    ticker_hor.l: 1
    phase_timer.l: 1
    vbounce_dir.l: 1
    vbounce_count.l: 1
    hscroll_pos.l: 1
    hscroll_dir.l: 1
