// Regression test for BOB mirror row format.
// The source BOB is a plain 32px, 2-row image built WITHOUT --add-word (the
// common case). Horizontal mirroring must bit-reverse the entire stored row
// (no assumption about optional --add-word scroll padding); vertical
// mirroring must preserve plane order while reversing row order.

code main:
    extern func CreateBob(descriptor_ptr: int, save_background: int) -> int;
    extern func MirrorBobHorizontally(handle: int) -> int;
    extern func MirrorBobVertically(handle: int) -> int;
    extern func DestroyBob(handle: int) -> void;
    extern var bob_mirror_format_desc: int;

    asm {
        jsr main
        rts
    }

    proc validate_horizontal(handle: int) -> int {
        var status: int = 0;

        asm {
            move.l @handle,a0
            move.l (a0),a0
            addq.l #4,a0

            cmpi.w #$4000,(a0)     ; row 0, pl 0, w0 (mirror of $0001,$0002)
            bne.s .h_fail_10
            cmpi.w #$8000,2(a0)    ; row 0, pl 0, w1
            bne.s .h_fail_11
            cmpi.w #$5000,16(a0)   ; row 0, pl 4, w0  (offset = 4*4)
            bne.s .h_fail_12
            cmpi.w #$9000,18(a0)   ; row 0, pl 4, w1
            bne.s .h_fail_13
            cmpi.w #$7000,24(a0)   ; row 1, pl 1, w0  (offset = 5*4+4)
            bne.s .h_fail_14
            cmpi.w #$B000,26(a0)   ; row 1, pl 1, w1
            bne.s .h_fail_15

            move.l @handle,a0
            move.l 4(a0),a0
            addq.l #4,a0
            cmpi.w #$4000,(a0)
            bne.s .h_fail_20
            cmpi.w #$8000,2(a0)
            bne.s .h_fail_21
            bra.s .h_done

.h_fail_10:
            move.l #-110,@status
            bra.s .h_done
.h_fail_11:
            move.l #-111,@status
            bra.s .h_done
.h_fail_12:
            move.l #-112,@status
            bra.s .h_done
.h_fail_13:
            move.l #-113,@status
            bra.s .h_done
.h_fail_14:
            move.l #-114,@status
            bra.s .h_done
.h_fail_15:
            move.l #-115,@status
            bra.s .h_done
.h_fail_20:
            move.l #-120,@status
            bra.s .h_done
.h_fail_21:
            move.l #-121,@status
.h_done:
        }

        return status;
    }

    proc validate_vertical(handle: int) -> int {
        var status: int = 0;

        asm {
            move.l @handle,a0
            move.l (a0),a0
            addq.l #4,a0

            cmpi.w #$000B,(a0)     ; row 0, pl 0, w0  (= src row 1, pl 0, w0)
            bne.s .v_fail_10
            cmpi.w #$000C,2(a0)    ; row 0, pl 0, w1
            bne.s .v_fail_11
            cmpi.w #$000D,4(a0)    ; row 0, pl 1, w0  (offset = 1*4)
            bne.s .v_fail_12
            cmpi.w #$0013,16(a0)   ; row 0, pl 4, w0  (offset = 4*4)
            bne.s .v_fail_13
            cmpi.w #$0014,18(a0)   ; row 0, pl 4, w1
            bne.s .v_fail_14
            cmpi.w #$0001,20(a0)   ; row 1, pl 0, w0  (offset = 5*4)
            bne.s .v_fail_15
            cmpi.w #$0002,22(a0)   ; row 1, pl 0, w1
            bne.s .v_fail_16

            move.l @handle,a0
            move.l 4(a0),a0
            addq.l #4,a0
            cmpi.w #$000B,(a0)
            bne.s .v_fail_20
            cmpi.w #$000C,2(a0)
            bne.s .v_fail_21
            bra.s .v_done

.v_fail_10:
            move.l #-210,@status
            bra.s .v_done
.v_fail_11:
            move.l #-211,@status
            bra.s .v_done
.v_fail_12:
            move.l #-212,@status
            bra.s .v_done
.v_fail_13:
            move.l #-213,@status
            bra.s .v_done
.v_fail_14:
            move.l #-214,@status
            bra.s .v_done
.v_fail_15:
            move.l #-215,@status
            bra.s .v_done
.v_fail_16:
            move.l #-216,@status
            bra.s .v_done
.v_fail_20:
            move.l #-220,@status
            bra.s .v_done
.v_fail_21:
            move.l #-221,@status
.v_done:
        }

        return status;
    }

    proc main() -> int {
        var src: int;
        var mirrored_h: int;
        var mirrored_v: int;
        var status: int;

        src = CreateBob(&bob_mirror_format_desc, 0);
        if (src == -1) {
            return -10;
        }

        mirrored_h = MirrorBobHorizontally(src);
        if (mirrored_h == -1) {
            call DestroyBob(src);
            return -20;
        }

        mirrored_v = MirrorBobVertically(src);
        if (mirrored_v == -1) {
            call DestroyBob(mirrored_h);
            call DestroyBob(src);
            return -30;
        }

        status = validate_horizontal(mirrored_h);
        if (status != 0) {
            call DestroyBob(mirrored_v);
            call DestroyBob(mirrored_h);
            call DestroyBob(src);
            return status;
        }

        status = validate_vertical(mirrored_v);
        if (status != 0) {
            call DestroyBob(mirrored_v);
            call DestroyBob(mirrored_h);
            call DestroyBob(src);
            return status;
        }

        call DestroyBob(mirrored_v);
        call DestroyBob(mirrored_h);
        call DestroyBob(src);
        return 0;
    }

    asm {
bob_mirror_format_data:
        dc.w 32,2                       ; stored_width=32 (2 chunks, no add_word), height=2
        dc.w $0001,$0002                 ; row 0, plane 0
        dc.w $0003,$0004                 ; row 0, plane 1
        dc.w $0005,$0006                 ; row 0, plane 2
        dc.w $0007,$0008                 ; row 0, plane 3
        dc.w $0009,$000A                 ; row 0, plane 4
        dc.w $000B,$000C                 ; row 1, plane 0
        dc.w $000D,$000E                 ; row 1, plane 1
        dc.w $000F,$0010                 ; row 1, plane 2
        dc.w $0011,$0012                 ; row 1, plane 3
        dc.w $0013,$0014                 ; row 1, plane 4

bob_mirror_format_mask:
        dc.w 32,2                       ; stored_width=32 (2 chunks, no add_word), height=2
        dc.w $0001,$0002                 ; row 0, plane 0
        dc.w $0003,$0004                 ; row 0, plane 1
        dc.w $0005,$0006                 ; row 0, plane 2
        dc.w $0007,$0008                 ; row 0, plane 3
        dc.w $0009,$000A                 ; row 0, plane 4
        dc.w $000B,$000C                 ; row 1, plane 0
        dc.w $000D,$000E                 ; row 1, plane 1
        dc.w $000F,$0010                 ; row 1, plane 2
        dc.w $0011,$0012                 ; row 1, plane 3
        dc.w $0013,$0014                 ; row 1, plane 4

bob_mirror_format_palette:
        dc.w $000,$111,$222,$333,$444,$555,$666,$777
        dc.w $888,$999,$AAA,$BBB,$CCC,$DDD,$EEE,$FFF
        dc.w $012,$123,$234,$345,$456,$567,$678,$789
        dc.w $89A,$9AB,$ABC,$BCD,$CDE,$DEF,$F0F,$0F0

bob_mirror_format_desc:
        dc.l bob_mirror_format_data
        dc.l bob_mirror_format_mask
        dc.l bob_mirror_format_palette
        dc.w 32                         ; conv_w = 32 (2 chunks, no add_word)
        dc.w 2
        dc.w 32
    }