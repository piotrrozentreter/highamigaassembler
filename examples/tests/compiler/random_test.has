// Focused RNG regression test.
// Return 0 on success; return a negative code for the first failed contract.

code test:
    extern func SeedRnd(seed: int) -> void;
    extern func RndMaxAMOS(max: int) -> int;

    asm {
        jmp main
    }

    // Reseeding must reproduce the complete sequence, without requiring
    // any values in the sequence to be different from each other.
    proc test_reseeding() -> int {
        var first:int;
        var second:int;
        var third:int;
        var fourth:int;

        call SeedRnd(0x13579BDF);
        first = RndMaxAMOS(257);
        second = RndMaxAMOS(257);
        third = RndMaxAMOS(257);
        fourth = RndMaxAMOS(257);

        call SeedRnd(0x13579BDF);
        if (first != RndMaxAMOS(257)) {
            return -1;
        }
        if (second != RndMaxAMOS(257)) {
            return -2;
        }
        if (third != RndMaxAMOS(257)) {
            return -3;
        }
        if (fourth != RndMaxAMOS(257)) {
            return -4;
        }

        return 0;
    }

    // Every returned value must satisfy 0 <= value < max. These maxima
    // exercise tiny, byte-sized, power-of-two, and just-over-power-of-two ranges.
    proc test_bounds() -> int {
        var i:int;
        var value:int;

        call SeedRnd(0x2468ACE0);
        for i = 0 to 7 {
            value = RndMaxAMOS(2);
            if (value < 0 || value >= 2) {
                return -10;
            }
            value = RndMaxAMOS(3);
            if (value < 0 || value >= 3) {
                return -11;
            }
            value = RndMaxAMOS(100);
            if (value < 0 || value >= 100) {
                return -12;
            }
            value = RndMaxAMOS(256);
            if (value < 0 || value >= 256) {
                return -13;
            }
            value = RndMaxAMOS(257);
            if (value < 0 || value >= 257) {
                return -14;
            }
        }

        return 0;
    }

    proc test_invalid_maxima() -> int {
        if (RndMaxAMOS(0) != 0) {
            return -20;
        }
        if (RndMaxAMOS(1) != 0) {
            return -21;
        }
        if (RndMaxAMOS(-1) != 0) {
            return -22;
        }
        if (RndMaxAMOS(0x01000001) != 0) {
            return -23;
        }
        return 0;
    }

    proc main() -> int {
        var result:int;

        result = test_reseeding();
        if (result != 0) {
            return result;
        }
        result = test_bounds();
        if (result != 0) {
            return result;
        }
        return test_invalid_maxima();
    }
