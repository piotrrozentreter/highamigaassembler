// Regression coverage for the frame-register selection bug.
//
// A proc with parameters but NO locals never emits the a4 frame setup, so it
// must address its parameters through a6. Reads and stores through the same
// pointer parameter must use the same, initialised frame register.

bss frame_reg_data:
    struct Rec[4] { x: i16, y: i16 }

code main:
    asm {
        jsr entry
        rts
    }

    // Params, no locals: every parameter reference must go through a6.
    proc store_no_locals(p: Rec*, v: int) -> void {
        p->x = 7;   // expect: move.l 8(a6),a0  (never 8(a4))
    }

    proc read_no_locals(p: Rec*) -> int {
        return p->x;  // expect: move.l 8(a6),a0
    }

    // Params + locals: a4 is initialised from a6 in the prologue, so parameter
    // reads and stores are equivalent whichever spelling is emitted.
    proc read_store_with_locals(p: Rec*) -> int {
        var t: int;
        t = p->x;   // expect: parameter read matches the store below
        p->x = 9;
        return t;
    }

    // Params, no locals, inline asm substitution of a stack parameter.
    proc asm_param_no_locals(x: int) -> void {
        asm {
            move.l d3,@x  ; expect: move.l d3,8(a6)
        }
    }

    proc entry() -> long {
        var r: int;
        store_no_locals(&Rec[1], 0);
        r = read_no_locals(&Rec[1]);   // expect: 7
        r = r + read_store_with_locals(&Rec[1]);
        return r;
    }
