// Scroll Function Example - Demonstrates how to call Scroll from HAS
// Requires: External Scroll function linked from graphics library

code main:
    // Declare the external Scroll function with register-based parameters
    // All 7 parameters use dedicated data registers for efficiency
    extern func Scroll(__reg(d0) x0: int, __reg(d1) y0: int, __reg(d2) x1: int, 
                       __reg(d3) y1: int, __reg(d4) hor: int, __reg(d5) vert: int, 
                       __reg(d6) pixels: int) -> int;

    asm {
        jsr main
        rts
    }

    // --- Helper: Scroll full screen upward ---
    proc scroll_screen_up(pixels: int) -> int {
        var result: int;
        result = Scroll(0, 0, 319, 255, 0, -1, pixels);
        return result;
    }

    // --- Helper: Scroll full screen downward ---
    proc scroll_screen_down(pixels: int) -> int {
        var result: int;
        result = Scroll(0, 0, 319, 255, 0, 1, pixels);
        return result;
    }

    // --- Helper: Scroll full screen left ---
    proc scroll_screen_left(pixels: int) -> int {
        var result: int;
        result = Scroll(0, 0, 319, 255, -1, 0, pixels);
        return result;
    }

    // --- Helper: Scroll full screen right ---
    proc scroll_screen_right(pixels: int) -> int {
        var result: int;
        result = Scroll(0, 0, 319, 255, 1, 0, pixels);
        return result;
    }

    // --- Scroll a sub-region (window) ---
    proc scroll_window(x0: int, y0: int, x1: int, y1: int, 
                       dx: int, dy: int, pixels: int) -> int {
        // dx, dy: direction flags (-1/0/1)
        var result: int;
        result = Scroll(x0, y0, x1, y1, dx, dy, pixels);
        return result;
    }

    // --- Safe scroll with validation ---
    proc safe_scroll_up(pixels: int) -> int {
        // Validate input range (e.g., 0-256 pixels)
        if (pixels < 0 || pixels > 256) {
            return -1;  // Invalid input
        }
        
        // Attempt to scroll full screen up
        var result: int;
        result = Scroll(0, 0, 319, 255, 0, -1, pixels);
        
        if (result != 0) {
            // Scroll failed (e.g., incompatible graphics mode)
            return -1;
        }
        
        return 0;  // Success
    }

    // --- Animated scroll: scroll region repeatedly ---
    proc animate_scroll_left(x0: int, y0: int, x1: int, y1: int, 
                             pixels_per_frame: int, num_frames: int) -> int {
        var frame: int;
        var result: int;
        
        frame = 0;
        while (frame < num_frames) {
            // Scroll left by pixels_per_frame pixels
            result = Scroll(x0, y0, x1, y1, -1, 0, pixels_per_frame);
            
            if (result != 0) {
                return -1;  // Scroll failed
            }
            
            frame = frame + 1;
        }
        
        return 0;  // All frames scrolled successfully
    }

    // --- Main program ---
    proc main() -> int {
        var rc: int;

        // Test 1: Scroll full screen up by 16 pixels
        rc = scroll_screen_up(16);
        if (rc != 0) {
            return -1;  // Error
        }

        // Test 2: Scroll a window region (100, 50) to (200, 150) left by 8 pixels
        rc = scroll_window(100, 50, 200, 150, -1, 0, 8);
        if (rc != 0) {
            return -1;  // Error
        }

        // Test 3: Scroll with safe validation
        rc = safe_scroll_up(32);
        if (rc != 0) {
            return -1;  // Error
        }

        // Test 4: Animate a window scrolling over 10 frames
        rc = animate_scroll_left(50, 50, 270, 200, 4, 10);
        if (rc != 0) {
            return -1;  // Error
        }

        // All tests passed
        return 0;
    }
