// trackio_print_asset_demo.has
// Loads TrackIo asset id=1 (custom ADF container), prints a hex preview,
// then waits for Enter before returning to DOS.

#pragma lockreg(a5);

#include "includes/trackio_defs.has";

extern var fonts: int;   // font bitmap data from lib/font8x8.s

const ASSET_BUF_SIZE = 4096;
const HEX_BYTES_PER_LINE = 16;
const HEX_PREVIEW_BYTES = 64;
const HEX_LINE_BUF_SIZE = 49;   // 16 bytes => "HH " * 16 + NUL
const KEY_ENTER = 68;      // $44 (Return)
const KEY_KP_ENTER = 67;   // $43 (Keypad Enter)
const KEY_RELEASE_MASK = 127;

code demo:
    extern func TakeSystem() -> void;
    extern func ReleaseSystem() -> void;

    extern func SetGraphicsMode(mode: int) -> int;
    extern func ClearScreen() -> int;
    extern func SetFont(ptr: int) -> int;
    extern func SetColor(id: int, col: int) -> int;
    extern func Text(x: int, y: int, msg: int, color: int) -> int;
    extern func UpdateCopperList() -> int;
    extern func WaitVBlank() -> int;

    extern func InitKeyboard() -> void;
    extern func GetKey() -> byte;

    public main;

    asm {
        jsr TakeSystem
        jsr main
        jmp ReleaseSystem
    }

    proc main() -> int {
        var rc: int;
        var need: int;
        var readn: int;
        var key: byte = 0;
        var bytes_to_show: int;
        var row: int;
        var offset: int;
        var line_bytes: int;

        rc = SetGraphicsMode(0);
        if (rc == -1) {
            return -10;
        }

        call SetFont(&fonts);
        call SetColor(0, $000);
        call SetColor(1, $FFF);
        call ClearScreen();

        call Text(1, 1, &title_msg, 1);
        call Text(1, 3, &swap_msg_1, 1);
        call Text(1, 5, &swap_msg_3, 1);
        call UpdateCopperList();

        call InitKeyboard();

        // Wait for Enter before starting TrackIo reads.
        while (((key & KEY_RELEASE_MASK) != KEY_ENTER) && ((key & KEY_RELEASE_MASK) != KEY_KP_ENTER)) {
            call WaitVBlank();
            key = GetKey();
        }

        call ClearScreen();
        call Text(1, 1, &title_msg, 1);
        call Text(1, 3, &wait_msg, 1);

        rc = TrackIoInit();
        if (rc != 0) {
            call Text(1, 5, &err_init_msg, 1);
            call UpdateCopperList();
            return TrackIoGetLastError();
        }

        need = TrackIoGetFileSize(1);
        if (need < 0) {
            call Text(1, 5, &err_size_msg, 1);
            call TrackIoDone();
            call UpdateCopperList();
            return need;
        }

        if (need > (ASSET_BUF_SIZE - 1)) {
            call Text(1, 5, &err_big_msg, 1);
            call TrackIoDone();
            call UpdateCopperList();
            return TRACKIO_ERR_DST_TOO_SMALL;
        }

        readn = TrackIoReadFile(1, &asset_buf, ASSET_BUF_SIZE - 1);
        if (readn < 0) {
            call Text(1, 5, &err_read_msg, 1);
            call TrackIoDone();
            call UpdateCopperList();
            return readn;
        }

        call Text(1, 7, &asset_label, 1);
        call Text(1, 8, &asset_hex_label, 1);

        bytes_to_show = readn;
        if (bytes_to_show > HEX_PREVIEW_BYTES) {
            bytes_to_show = HEX_PREVIEW_BYTES;
        }

        row = 10;
        offset = 0;
        while (offset < bytes_to_show) {
            line_bytes = bytes_to_show - offset;
            if (line_bytes > HEX_BYTES_PER_LINE) {
                line_bytes = HEX_BYTES_PER_LINE;
            }

            call BuildHexLine(offset, line_bytes);
            call Text(1, row, &hex_line, 1);

            offset = offset + line_bytes;
            row = row + 1;
        }

        if (bytes_to_show == 0) {
            call Text(1, row, &hex_empty_msg, 1);
            row = row + 1;
        }

        if (readn > HEX_PREVIEW_BYTES) {
            call Text(1, row, &hex_more_msg, 1);
        }

        call TrackIoDone();

        call UpdateCopperList();

        while(1){}
        return 0;
    }

    proc HexDigit(nibble: int) -> byte {
        if (nibble < 10) {
            return 48 + nibble;
        }
        return 55 + nibble;
    }

    proc BuildHexLine(start: int, count: int) -> int {
        var i: int = 0;
        var b: int;
        var hi: int;
        var lo: int;
        var p: int;

        while (i < count) {
            b = asset_buf[start + i] & 255;
            hi = b / 16;
            lo = b % 16;
            p = i * 3;

            hex_line[p] = HexDigit(hi);
            hex_line[p + 1] = HexDigit(lo);
            hex_line[p + 2] = 32;

            i = i + 1;
        }

        if (count > 0) {
            hex_line[(count * 3) - 1] = 0;
        } else {
            hex_line[0] = 0;
        }

        return 0;
    }

data demo_data:
    title_msg.b = "TrackIo asset 1 viewer", 0
    swap_msg_1.b = "Insert TrackIo data disk into DF0:", 0
    swap_msg_3.b = "Press ENTER to continue...", 0
    wait_msg.b = "Press ENTER to return to DOS", 0
    asset_label.b = "Asset 1:", 0
    asset_hex_label.b = "Hex preview (first bytes):", 0
    hex_empty_msg.b = "(0 bytes read)", 0
    hex_more_msg.b = "... truncated preview ...", 0

    err_init_msg.b = "TrackIoInit failed", 0
    err_size_msg.b = "TrackIoGetFileSize failed", 0
    err_read_msg.b = "TrackIoReadFile failed", 0
    err_big_msg.b  = "Asset too large for ASSET_BUF_SIZE", 0

bss demo_bss:
    asset_buf.b[ASSET_BUF_SIZE]
    hex_line.b[HEX_LINE_BUF_SIZE]
