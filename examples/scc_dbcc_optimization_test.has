// Demonstrates the branchless Scc boolean-assignment and DBcc counter-loop
// codegen fast paths described in docs/CODEGEN_SCC_DBCC_TIPS.md.
//
// Inspect the generated assembly (hasc examples/scc_dbcc_optimization_test.has -o out.s)
// to see the effect of each optimization directly.

code test:

    // --- Scc branchless boolean assignment ------------------------------
    // `if <comparison> { v = 1 } else { v = 0 }` (or the 0/1-swapped form)
    // compiles to a branchless cmp+Scc+andi+neg sequence instead of a
    // branchy if/else with labels.

    proc is_greater(a: int, b: int) -> int {
        var flag: int = 0;
        if (a > b) {
            flag = 1;
        } else {
            flag = 0;
        }
        return flag;  // 1 if a > b, else 0 - no branch in the generated code
    }

    proc is_not_greater(a: int, b: int) -> int {
        var flag: int = 0;
        // then=0/else=1 uses the *negated* comparison (a <= b), still branchless.
        if (a > b) {
            flag = 0;
        } else {
            flag = 1;
        }
        return flag;  // 1 if a <= b, else 0
    }

    proc is_equal(a: int, b: int) -> int {
        var flag: int = 0;
        if (a == b) {
            flag = 1;
        } else {
            flag = 0;
        }
        return flag;
    }

    // Different targets in each branch, or non-0/1 literals, still compile
    // via the normal branchy if/else path (the fast path only applies to the
    // exact `v = 1` / `v = 0` pattern).
    proc is_greater_branchy(a: int, b: int) -> int {
        var flag: int = 0;
        var other: int = 0;
        if (a > b) {
            flag = 1;
        } else {
            other = 1;
        }
        return flag;
    }

    // --- DBcc counter loop ------------------------------------------------
    // `for i = start to end [by step] { body }` compiles to a single `dbra`
    // instruction (instead of a per-iteration load/compare/increment/store)
    // whenever start/end/step are compile-time constants and the loop
    // variable is never read or written in the body.

    proc sum_constant_count(dummy: int) -> int {
        var total: int = 0;
        var i: int = 0;
        // `i` is never referenced below, so this becomes a single dbra loop.
        for i = 0 to 99 {
            total = total + 1;
        }
        return total;  // 100
    }

    // When the loop variable IS used in the body, the general compare/branch
    // path is used instead (still correct, just not the dbra fast path).
    proc sum_using_index(dummy: int) -> int {
        var total: int = 0;
        var i: int = 0;
        for i = 0 to 9 {
            total = total + i;
        }
        return total;  // 45
    }

    // Nested loops: dbra loops share a single hardware counter register, so a
    // loop nested inside another active dbra loop automatically saves and
    // restores the outer counter around its own use.
    proc nested_delay(dummy: int) -> int {
        var total: int = 0;
        var i: int = 0;
        var j: int = 0;
        for i = 0 to 9 {
            for j = 0 to 9 {
                total = total + 1;
            }
        }
        return total;  // 100
    }
