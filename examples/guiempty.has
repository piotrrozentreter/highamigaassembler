// Isolation test 3: the gui_intuition core open path with NO widgets.
// GuiInit -> GuiBeginWindow -> GuiShow -> event loop -> close.
// If this empty window faults, the bug is in the core open/redraw path.
// If it opens fine, the bug is in GuiAddLabel/EditBox/Button.
const WIN_X = 40;
const WIN_Y = 30;
const WIN_W = 320;
const WIN_H = 120;
const FORM_IDCMP = $0020026C;
const FORM_FLAGS = $0000100E;
const GUI_EVT_CLOSE = 1;

code guiempty:

    extern func WBStartup() -> void;
    extern func WBExit() -> void;
    extern func GuiInit() -> int;
    extern func GuiShutdown() -> void;
    extern func GuiBeginWindow(title: int, x: int, y: int, w: int, h: int,
                               idcmp: int, flags: int) -> int;
    extern func GuiShow() -> int;
    extern func GuiCloseWindow() -> void;
    extern func GuiWaitEvent() -> int;

    public main;

    asm {
        jsr WBStartup
        jsr main
        jsr WBExit
        rts
    }

    proc main() -> int {
        var status: int;
        var win: int;
        var evt: int;
        var running: int = 1;

        status = GuiInit();
        if (status != 0) {
            return -1;
        }

        status = GuiBeginWindow(&win_title, WIN_X, WIN_Y, WIN_W, WIN_H,
                                FORM_IDCMP, FORM_FLAGS);
        if (status != 0) {
            call GuiShutdown();
            return -1;
        }

        win = GuiShow();
        if (win == 0) {
            call GuiShutdown();
            return -1;
        }

        while (running != 0) {
            evt = GuiWaitEvent();
            if (evt == GUI_EVT_CLOSE) {
                running = 0;
            }
        }

        call GuiCloseWindow();
        call GuiShutdown();
        return 0;
    }

data guiempty_strings:
    win_title.b = "Empty", 0
