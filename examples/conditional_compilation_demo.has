// Demonstrates #ifdef/#ifndef/#else/#endif based on const declarations.

const BUILD_FAST = 1;

#ifndef DEBUG_BUILD
const DEBUG_ENABLED = 0;
#else
const DEBUG_ENABLED = 1;
#endif

// #if IDENT OP EXPR: comparison-based gating against a previously-defined const.
const API_VERSION = 3;

#if API_VERSION >= 3
const USE_NEW_API = 1;
#else
const USE_NEW_API = 0;
#endif

code conditional_demo:
#ifdef BUILD_FAST
    proc selected_mode() -> int {
        return 1;
    }
#else
    proc selected_mode() -> int {
        return 0;
    }
#endif

    proc main() -> int {
        // Returns 1 for fast mode + optional debug flag + new-API flag.
        return selected_mode() + DEBUG_ENABLED + USE_NEW_API;
    }
