        var running: int = 1;

        while (running != 0) {
            evt = GuiWaitEvent();
            id = GuiGetEventID();

            if (evt == GUI_EVT_CLOSE) {
                running = on_close();
            }

            if (evt == GUI_EVT_BUTTON) {
