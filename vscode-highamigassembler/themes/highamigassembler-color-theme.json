{
  "$schema": "vscode://schemas/color-theme",
  "name": "High Amiga Assembler Colors",
  "type": "dark",
  "colors": {
    "editor.background": "#1c1818a1",
    "editor.foreground": "#F8F8F2",
    "editorLineNumber.foreground": "#888888"
  },
  "tokenColors": [
    {
      "scope": "keyword.directive",
      "settings": {
        "foreground": "#00BB00"
      }
    },
    {
      "scope": [
        "keyword.directive.highamigassembler",
        "keyword.directive.include.highamigassembler"
      ],
      "settings": {
        "foreground": "#00BB00"
      }
    },
    {
      "scope": [
        "keyword.directive.if.highamigassembler"
      ],
      "settings": {
        "foreground": "#FF8C00"
      }
    },
    {
      "scope": [
        "keyword.directive.ifdef.highamigassembler"
      ],
      "settings": {
        "foreground": "#00CED1"
      }
    },
    {
      "scope": [
        "keyword.directive.ifndef.highamigassembler"
      ],
      "settings": {
        "foreground": "#FF69B4"
      }
    },
    {
      "scope": [
        "keyword.directive.endif.highamigassembler"
      ],
      "settings": {
        "foreground": "#ADFF2F"
      }
    },
    {
      "scope": [
        "entity.name.function.highamigassembler"
      ],
      "settings": {
        "foreground": "#FFD700" 
      }
    },
    {
      "scope": [
        "keyword.other.instruction.highamigassembler"
      ],
      "settings": {
        "foreground": "#008000"
      }
    },
    {
      "scope": [
        "keyword.declaration.proc.highamigassembler"
      ],
      "settings": {
        "foreground": "#D35400",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "keyword.declaration.func.highamigassembler"
      ],
      "settings": {
        "foreground": "#009688",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "storage.type.highamigassembler"
      ],
      "settings": {
        "foreground": "#B000B5",
        "fontStyle": "bold"
      }
    }
  ]
}
